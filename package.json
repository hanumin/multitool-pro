{
  "name": "server-dashboard-tauri",
  "private": true,
  "version": "1.11.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:why": "python scripts/check-why-comments.py --exit-error --verbose",
    "check:why:stats": "python scripts/check-why-comments.py --stats",
    "check:all": "npm run check:install && npm run check:tsc && npm run check:py && npm run check:why",
    "check:install": "npm install --loglevel=error --no-audit --no-fund",
    "check:tsc": "npx tsc --noEmit",
    "check:py": "python -m py_compile backend/app.py",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "ansi-to-html": "^0.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "husky": "^9.1.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
